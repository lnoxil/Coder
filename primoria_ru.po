"점령하거든 꼭 짓거라.[-]"
msgstr ""

msgid "[89D2FF]<em>익숙한 대로</em> 해볼래요?"
"[89D2FF]<em>익숙한 대로</em> 해볼래요?\n"
"아니면 <em>새로운 걸</em> 해볼래요?[-]"
msgstr ""

msgid "[89D2FF]<em>자원유도석</em>을 묻으면,"
"[89D2FF]<em>자원유도석</em>을 묻으면,\n"
"<em>크레이터</em>가 활성화된다 하더라고요.[-]"
msgstr ""

msgid "[89D2FF]<em>제브라케라톱스</em>를 찾아가보자고.[-]"
msgstr ""

msgid "[89D2FF]<em>제브라케라톱스</em>를 추적해보자고.[-]"
msgstr ""

msgid "[89D2FF]<em>지원단체</em> 사람들은 정보를 많이 알아요."
"[89D2FF]<em>지원단체</em> 사람들은 정보를 많이 알아요.\n"
"캠프에 가서 접촉하여 <em>정보원</em>을 개척하세요.[-]"
msgstr ""

msgid "[89D2FF]<em>캠프로 귀환</em>할래요?[-]"
msgstr ""

msgid "[89D2FF]<em>콤프소</em>는 이 섬에서 중요한 비상식량이에요."
"[89D2FF]<em>콤프소</em>는 이 섬에서 중요한 비상식량이에요.\n"
"문제는 우리만 그런 게 아니란 건데, <em>통신소</em>에서 더 얘기하죠.[-]"
msgstr ""

msgid "[89D2FF]<em>크레이터</em>와 <em>워프홀</em>을 찾으며 <em>모험</em>을"
"[89D2FF]<em>크레이터</em>와 <em>워프홀</em>을 찾으며 <em>모험</em>을\n"
"하는 모양인데, <em>탐색</em>하는 법을 알려주마.[-]"
msgstr ""

msgid "[89D2FF]<em>통나무</em>, <em>갈대 줄기</em>가 필요해요."
"[89D2FF]<em>통나무</em>, <em>갈대 줄기</em>가 필요해요.\n"
"<em>바로 저 옆 호수</em>에 있어요.[-]"
msgstr ""

msgid "[89D2FF]<em>통신소</em>에서 더 얘기해요."
"[89D2FF]<em>통신소</em>에서 더 얘기해요.\n"
"요리 태우지 말고요.[-]"
msgstr ""

msgid "[89D2FF]<em>투구게</em>의 껍질이 방음효과가 있다는군."
"[89D2FF]<em>투구게</em>의 껍질이 방음효과가 있다는군.\n"
"자네덕분에 확인해볼 수 있겠어.[-]"
msgstr ""

msgid "[89D2FF]<em>표지판</em>을 지으면 다른 개척자들에게"
"[89D2FF]<em>표지판</em>을 지으면 다른 개척자들에게\n"
"자네가 누구인지를 보여줄 수 있어.[-]"
msgstr ""

msgid "[89D2FF]<em>필요한 걸</em> 챙겨주고 싶었어.[-]"
msgstr ""

msgid "[89D2FF]<em>항해</em>는 어땠나요?"
"[89D2FF]<em>항해</em>는 어땠나요?\n"
"다른 섬에 오니 또 기분이 색다르죠?[-]"
msgstr ""

msgid "[89D2FF]<em>호수의 브라키오사우루스</em>를 봤나요?"
"[89D2FF]<em>호수의 브라키오사우루스</em>를 봤나요?\n"
"그런 게 야생이죠.[-]"
msgstr ""

msgid "[89D2FF]<em>화물 워프홀</em>을 발견했구나. 얘야.[-]"
msgstr ""

msgid "[89D2FF]K. 끝까지 들어봐."
"[89D2FF]K. 끝까지 들어봐.\n"
"자, 여러분, 문명은 문제도 많지만 장점도 많아.[-]"
msgstr ""

msgid "[89D2FF]K. 무전 사이에 정중히 끼어 드는 건,"
"[89D2FF]K. 무전 사이에 정중히 끼어 드는 건,\n"
"지구에서도 흠 잡힐 만한 일은 아녀.[-]"
msgstr ""

msgid "[89D2FF]K? 나야. 찰리."
"[89D2FF]K? 나야. 찰리.\n"
"꼬리 없는 거 확인했어. 구조 잘 마무리해.[-]"
msgstr ""

msgid "[89D2FF]K가 따로 무전을 보냈다."
"[89D2FF]K가 따로 무전을 보냈다.\n"
"<em>개인섬</em>은 마음에 드나요?[-]"
msgstr ""

msgid "[89D2FF]K가 속한 회사 역시 그 대상이다."
"[89D2FF]K가 속한 회사 역시 그 대상이다.\n"
"지원단체들은 정보를 갖고 있지만, 아무에게나 넘기진 않는다.[-]"
msgstr ""

msgid "[89D2FF]K가 안전 가옥에서 재료는 챙겨줬을 것이니,"
"[89D2FF]K가 안전 가옥에서 재료는 챙겨줬을 것이니,\n"
"<em>사유지</em>를 채워봐야 할 것 같은데.[-]"
msgstr ""

msgid "[89D2FF]K가 해독된 문서를 읽었다.[-]"
msgstr ""

msgid "[89D2FF]K는 다른 조난자들과 <em>북동쪽</em>에 있어."
"[89D2FF]K는 다른 조난자들과 <em>북동쪽</em>에 있어.\n"
"찰리는 마지막 조난자까지 확인하고 갈 거야.[-]"
msgstr ""

msgid "[89D2FF]K는 다른 활동에 바빠졌다."
"[89D2FF]K는 다른 활동에 바빠졌다.\n"
"정보를 얻기 위해 지원단체들과 접촉하고 있다.[-]"
msgstr ""

msgid "[89D2FF]X의 전용 무전기로 연락이 왔다.[-]"
msgstr ""

msgid "[89D2FF][#NameTag:#prologue_guide_nametag_clerk]세상에."
"[89D2FF][#NameTag:#prologue_guide_nametag_clerk]세상에.\n"
"걘 제 조카예요.[-]"
msgstr ""

msgid "[89D2FF]…[-]"
msgstr "[89D2FF] ... [-]"

msgid "[89D2FF]…지지직[-]"
msgstr ""

msgid "[89D2FF]가시덩굴이 있다니."
"[89D2FF]가시덩굴이 있다니.\n"
"<em>작업용 칼</em>을 하나 갖고 다니는 게 좋겠네요.[-]"
msgstr ""

msgid "[89D2FF]가열하니까 <em>모닥불</em>에서 해야겠죠?"
"[89D2FF]가열하니까 <em>모닥불</em>에서 해야겠죠?\n"
"<em>꼬치구이</em> 같은 걸로요.[-]"
msgstr ""

msgid "[89D2FF]가치있는 재료들은 남아있으나, 찰리가 말한 쌓여있는 돈은 남아있지 않다.[-]"
msgstr ""

msgid "[89D2FF]각각의 세상엔 어울리는 옷이 있어요."
"[89D2FF]각각의 세상엔 어울리는 옷이 있어요.\n"
"이곳 재료로 옷을 만들어 봐요. 통신소에서 더 얘기하죠.[-]"
msgstr ""

msgid "[89D2FF]개가 위치를 아니까 같이 와요."
"[89D2FF]개가 위치를 아니까 같이 와요.\n"
"머리도 식히고, 주변도 둘러보고, 이걸로 얘기하죠.[-]"
msgstr ""

msgid "[89D2FF]개인섬에도 아쉬운 점은 있지."
"[89D2FF]개인섬에도 아쉬운 점은 있지.\n"
"자연물이 그리 풍족하다고 볼 수는 없거든.[-]"
msgstr ""

msgid "[89D2FF]개인섬에선 <em>사유지</em>를 선언할 수 있어요.[-]"
msgstr ""

msgid "[89D2FF]개인섬엔 어떻게 갈래요? 뗏목으로?"
"[89D2FF]개인섬엔 어떻게 갈래요? 뗏목으로?\n"
"아니면 그 멋진 <em>열기구</em>를 타고 갈래요?[-]"
msgstr ""

msgid "[89D2FF]개조한 장비를 가져오시면 잠재력을 이끌어낼 수 있을 것입니다.[-]"
msgstr ""

msgid "[89D2FF]개척 재료를 보내주시면, 그에 걸맞는 기술을 서포트해드리겠습니다.[-]"
msgstr ""

msgid "[89D2FF]개척자가 된 이상 한번쯤은 가보는 게 좋을 거예요."
"[89D2FF]개척자가 된 이상 한번쯤은 가보는 게 좋을 거예요.\n"
"먹고 사는 문제도 있고, 세상이 어떤지 궁금하기도 하니까.[-]"
msgstr ""

msgid "[89D2FF]개척자들은 여기서 대거 모여들고, 정보의 흐름 또한 그렇다."
"[89D2FF]개척자들은 여기서 대거 모여들고, 정보의 흐름 또한 그렇다.\n"
"연락망 한 곳에서 조심스레 무전을 보냈다.[-]"
msgstr ""

msgid "[89D2FF]개척재료는 통신소를 거쳐 저희 쪽으로 보내주십시오.[-]"
msgstr ""

msgid "[89D2FF]거기서 <em>8월 33일</em>이란 걸 봤습니다."
"[89D2FF]거기서 <em>8월 33일</em>이란 걸 봤습니다.\n"
"자세한 건 기억이 안나지만...[-]"
msgstr ""

msgid "[89D2FF]거기서 한 때 보이지 않는 워프 에너지가 분출됐단다. 지금은 바닥까지 갈라져 드러나게 됐지.[-]"
msgstr ""

msgid "[89D2FF]거기선 건물 내구도 걱정없고,"
"[89D2FF]거기선 건물 내구도 걱정없고,\n"
"유지비도 들지 않으니까 말이여.[-]"
msgstr ""

msgid "[89D2FF]거기에 인위적으로 워프 활동을 가속하면, 여러 가지 기대되는 예상값들이 있단다.[-]"
msgstr ""

msgid "[89D2FF]거긴 <em>기름독섬</em>이오."
"[89D2FF]거긴 <em>기름독섬</em>이오.\n"
"거기서 <em>워프 스톤</em>을 캐오면 좋은 걸로 교환해주겠소.[-]"
msgstr ""

msgid "[89D2FF]거긴 사라지는 섬인 <em>불안정섬</em>이에요."
"[89D2FF]거긴 사라지는 섬인 <em>불안정섬</em>이에요.\n"
"개척자들은 주로 <em>캠프</em>로 모이죠.[-]"
msgstr ""

msgid "[89D2FF]거대 통신소 섬으로 떠나는 K를 따라갔다.[-]"
msgstr ""

msgid "[89D2FF]거참 슬픈 얘기하시네."
"[89D2FF]거참 슬픈 얘기하시네.\n"
"난 그 잘난 <em>문명</em>은 몇 년 안 살아봐서 잘 모르는데.[-]"
msgstr ""

msgid "[89D2FF]건물, 도구는 생존 확률을 높여주지.[-]"
msgstr ""

msgid "[89D2FF]계속 연락해요.[-]"
msgstr ""

msgid "[89D2FF]고개를 끄덕였다.[-]"
msgstr ""

msgid "[89D2FF]고객님. 개인섬에 도착하셨습니까?[-]"
msgstr ""

msgid "[89D2FF]고객님. 컨시어지입니다.[-]"
msgstr ""

msgid "[89D2FF]공룡이 있으면 한 번 보고나 싶네요.[-]"
msgstr ""

msgid "[89D2FF]그 방향 끝에 <em>크레이터</em>나 <em>워프홀</em>이 있단다."
"[89D2FF]그 방향 끝에 <em>크레이터</em>나 <em>워프홀</em>이 있단다.\n"
"얘야.[-]"
msgstr ""

msgid "[89D2FF]그 섬에서 앞으로 어떻게 살지 고민해봐요."
"[89D2FF]그 섬에서 앞으로 어떻게 살지 고민해봐요.\n"
"찰리, 다른 조난자 부탁하고, 꼬리 있나 잘 봐줘.[-]"
msgstr ""

msgid "[89D2FF]그 지역은 <em>기름독</em>이 문제인데,"
"[89D2FF]그 지역은 <em>기름독</em>이 문제인데,\n"
"그곳에서 난 재료로 <em>옷</em>을 만들면 좀 낫소.[-]"
msgstr ""

msgid "[89D2FF]그건 <em>균열</em>이란다. 얘야. 찾게 되면 자세한 이야기는 그 때 다시 해주마.[-]"
msgstr ""

msgid "[89D2FF]그게 이상해서 자꾸 기억에 남는데, 또 이리 물어보는 사람이 생기잖아요."
"[89D2FF]그게 이상해서 자꾸 기억에 남는데, 또 이리 물어보는 사람이 생기잖아요.\n"
"내가 누군진 기억 말고, 그 사실만 기억해주세요.\"[-]"
msgstr ""

msgid "[89D2FF]그나마 캠프의 <em>워프홀</em>로 보내면"
"[89D2FF]그나마 캠프의 <em>워프홀</em>로 보내면\n"
"사라지지 않더군요.[-]"
msgstr ""

msgid "[89D2FF]그때 일했던 동료가 더 위험도 높은 불안정섬 가는 길에 있을 겁니다."
"[89D2FF]그때 일했던 동료가 더 위험도 높은 불안정섬 가는 길에 있을 겁니다.\n"
"그 친구도 죽기 전에 누군가에게 말해두고 싶다고 하니 연락해 올 겁니다.\"[-]"
msgstr ""

msgid "[89D2FF]그때까지 우리 모두 꼭 <em>살아남아요. 앙코라.</em>[-]"
msgstr ""

msgid "[89D2FF]그래. 고마워."
"[89D2FF]그래. 고마워.\n"
"자꾸 <em>회사</em> 일 넘겨서 미안해. 찰리.[-]"
msgstr ""

msgid "[89D2FF]그래서 섬들이 모여 있는 모습 그대로, <em>불안정 군도</em>라고 부르고 있어요.[-]"
msgstr ""

msgid "[89D2FF]그래요. <em>모닥불</em>로 요리를 <em>가열</em>해요."
"[89D2FF]그래요. <em>모닥불</em>로 요리를 <em>가열</em>해요.\n"
"<em>꼬치구이</em>가 한 방법이죠.[-]"
msgstr ""

msgid "[89D2FF]그러면 <em>급조한 한손도끼</em>를 만들어 보죠.[-]"
msgstr ""

msgid "[89D2FF]그려. 내가 마음이 급했구먼."
"[89D2FF]그려. 내가 마음이 급했구먼.\n"
"<em>개인섬</em>에서 얘기 나눌 게 많으니 그때 봅시다.[-]"
msgstr ""

msgid "[89D2FF]그리고 아마 불안정섬에 왔으니"
"[89D2FF]그리고 아마 불안정섬에 왔으니\n"
"온갖 <em>단체</em>들이 당신에게 일을 시키려 하겠군요.[-]"
msgstr ""

msgid "[89D2FF]근데 <em>귀환 지점</em>이란 건 남의 땅에도 허락을 얻으면,"
"[89D2FF]근데 <em>귀환 지점</em>이란 건 남의 땅에도 허락을 얻으면,\n"
"거서 살 수도 있구, 좋은 건물이면 여럿이 살 수도.[-]"
msgstr ""

msgid "[89D2FF]근데 그건 알지?"
"[89D2FF]근데 그건 알지?\n"
"자본주의나 민주주의도 결국 오랫동안 살아남은 믿음이여.[-]"
msgstr ""

msgid "[89D2FF]근데 그건 좀 더 자네가 개척을 할 때 얘기고"
"[89D2FF]근데 그건 좀 더 자네가 개척을 할 때 얘기고\n"
"일단은 <em>간이 천막</em>을 <em>사유지</em>에 <em>완성</em>하는 걸 목표로 하자구.[-]"
msgstr ""

msgid "[89D2FF]근데 워프가 드문 개인섬은 자원이 부족해요."
"[89D2FF]근데 워프가 드문 개인섬은 자원이 부족해요.\n"
"<em>불안정섬</em>은 자원이 많고요.[-]"
msgstr ""

msgid "[89D2FF]근데 좀 곤란한 게 있긴 해요."
"[89D2FF]근데 좀 곤란한 게 있긴 해요.\n"
"<em>불안정섬</em>과 <em>개인섬</em> 문제죠.[-]"
msgstr ""

msgid "[89D2FF]근처 공터에 제각각의 복장을 한 사람들이 모여 있다.[-]"
msgstr ""

msgid "[89D2FF]근처에 나무 보이죠?"
"[89D2FF]근처에 나무 보이죠?\n"
"이제 <em>통나무</em>를 구해볼 차례예요.[-]"
msgstr ""

msgid "[89D2FF]근처에 냇물이 있어서 물은 따로 안 드렸어요."
"[89D2FF]근처에 냇물이 있어서 물은 따로 안 드렸어요.\n"
"물가로 가서 <em>물</em> 좀 드세요.[-]"
msgstr ""

