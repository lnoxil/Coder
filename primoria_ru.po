msgstr ""

msgid "나는 보았다. 정의가 인간의 형상으로 그곳에 들렀다. 정의는 눈을 가린 채 칼을 휘둘러 그것들의 살점을 베었고, 도끼로 사악한 정수리를 찍었으며, 망치로 못 박았다. 정의는 아무 말도 하지 않고 심판을 내렸다. 그것들의 무전이 증명하고 있었다. 처음 있는 일이었다."
msgstr ""

msgid "나는 부족장에게 신성한 영장을 받았다. 무법섬에서 벌어지는 전쟁은 성전이다. 모든 개척자는 부족에 들어가 자신의 의무에 종사하여야 한다. 징병을 거부하는 자는 반역자이다. 이는 역사의 진보를 거스르는 행동으로 엄벌로 다스려야 한다. 나는 집단의 힘을 믿는다."
msgstr ""

msgid "나는 불안정섬에서 산다. 안정해역의 삶은 삶 같지가 않았다. 예전에 도심에서 일할 때 그랬다. 손과 얼굴이 깨끗하고 셔츠는 말끔했다. 하얀 사무실은 냄새가 없었다. 그런 삶에서 육체는 활기를 잃고 정신은 병든다. 고통이 없으면 모든 게 무너져 내릴 것이다."
msgstr ""

msgid "나는 불안정섬을 좋아하지는 않어. 불안정섬의 지리적 특성 때문만은 아니여."
msgstr ""

msgid "나는 생존이란 개념을 모르겠습니다."
"나는 생존이란 개념을 모르겠습니다.\n"
"그건 무생물과 생물의 경계만큼이나 모호하죠.\n"
"생존을 위한 거라며 내세운 많은 탐욕을 봤습니다.\n"
"– 도덕주의자"
msgstr ""

msgid "나는 실망했다. 더 이상 개척 회의를 위해 일하지 않겠다. 돈도 제때 보내지 않는다니, 그러면서 무슨 경제를 이끄나? 나가 뒤져 버려라. 개척 회의."
msgstr ""

msgid "나는 아니고 말이야. 난 어릴 적에 충분히 바닥에 살았으니 됐어. 당신이 머무는 건 잠깐일 거고. 그러니 살면서 <em>{item_0}</em> 만들 일이 있어도 기분 나쁠 이유 없이 살면 되는 거야. 모든 건 흐름이고 거쳐가는 단계지. 당신아."
msgstr ""

msgid "나는 아직도 가끔 공룡 사이로 버스를 몰아."
"나는 아직도 가끔 공룡 사이로 버스를 몰아.\n"
"버스를 타고 왔으니 갈 때도 버스로 가는 게\n"
"논리적이지 않겠어?\n"
"– 상상가"
msgstr ""

msgid "나는 아침마다 깨진 유리로 면도를 한다. 위생을 생각하면 종은 짓이 아니지. 근데 이 짓거리를 하면 정신이 번쩍 들어. 칼질 잘못하면 무슨 병에 걸릴지 모르니까."
msgstr ""

msgid "나는 악마가 수레에 매달아 놓은 그릇이라고 생각했고 목표를 쫓아가 찔렀단다."
msgstr ""

msgid "나는 양치기가 거짓말을 한다는 확신이 들었다. 연기를 하고 있어."
msgstr ""

msgid "나는 어떤 특정한 사실이 문제다라고 말하는 게 아냐."
msgstr ""

msgid "나는 여러 가설에서 확고한 결론을 끌어내지는 못 했다. 그중 지지하는 가설을 꼽자면, 우연이다. 우연히 특정한 시간과 공간이 일정한 운동을 일으키고 있다. 사람들은 허무주의적인 견해라며 불쾌감을 드러냈다. 하지만 일어난 일은 그저 일어났을 뿐이다. 의미는 머릿속에 존재하는 거면 충분하다."
msgstr ""

msgid "나는 왜 이 메모를 작성하고 있는 걸까? 이 메모를 쓴다고 정말 K님과 찰리님이 읽을 수 있을 것도 아닌데. 나는 위로 받고 싶었던 걸까? 모르겠다. 조난자를 구하는 일이 나쁜 일은 아닐 거다. 하지만 과정에 많은 부분이 있다. 빡치는 부분도 있고 좋은 부분도 있다. 빡치는 게 많지만."
msgstr ""

msgid "나는 우산 밑에 독을 숨겨놨단다. 망명한 어느 나라 사람을 찔러야 했거든."
msgstr ""

msgid "나는 이론을 정교하게 만들고자 한다. 홍보처장의 고견이 필요하다. 메모가 밖으로 나가지 않게 주의해달라."
msgstr ""

msgid "나는 인사이트가 뛰어난 사람은 아니다. 그러나 나를 둘러싼 세상의 불가사의를 나름대로 추론하고 기록으로 남기고 싶다. 내가 남긴 추론들을 검증하려면 긴 세월이 흘러야 할 것이다."
msgstr ""

msgid "나는 일 때문에 먼 불안정섬에 나왔어. 소나무 같은 게 많고, 추운 곳이야. 오늘은 몸상태가 좋아서 편지나 써둘까 해. 편지라니. 원래 지구에 있을 땐 편지 같은 거 쓴 적 없었어. 여기선 편지가 낙이지. 화물 워프홀에 편지 보내면 간부들이 검열하니까 이건 사람 손으로 보낼게."
msgstr ""

msgid "나는 자산투자 전문가로 200억달러를 담당했어."
"나는 자산투자 전문가로 200억달러를 담당했어.\n"
"아내는 아름다웠어. 애인은 수염이 중후하고 권력이 있었지.\n"
"근데 워프 때 뇌세포가 손상을 겪어서 기억이 불명확해.\n"
"– 허풍선이"
msgstr ""

msgid "나는 자식이 하나 있는데, 둘은 미친 짓이야."
msgstr ""

msgid "나는 정치적인 데는 젬병이에요. 그래서 다른 문제는 제껴두고 연구에만 집중하고 싶었죠."
msgstr ""

msgid "나는 조난자들을 보면 고개 들지 말고 손을 뒤로 모으라고 소리 지른다. 나는 정확한 매듭법으로 그들의 손을 묶는다. 절대 묶인 사람 힘으로 풀 수 없는 매듭이다. 내 상관인 징병대장은 나를 좋아한다. 내 양심이 얼마나 고결함을 꿈꾸건, 나는 징병관이다."
msgstr ""

msgid "나는 죽음의 신 하데스다. 하데스."
msgstr ""

msgid "나는 준법시민이야. 법이 없을 땐 준법의 경계를 스스로 정해야 하는 게 준법시민의 자세지. 이걸 읽으면 꽤 질투가 날지도 몰라. 너는 꽤 성실히 일했는데, 어떤 인간은 이렇게 쉽게 벌어먹고 사는 게 화가 날지도 모르지. 하지만 성실함이 자연이 존중하는 척도는 아니잖아?"
msgstr ""

msgid "나는 지켜야 할 기밀 유지 의무가 있다. 서약서에도 서명을 했다. 하지만 갑이 서약서의 기반을 이루는 성실성을 위반했다. 서약서는 휴지 조각이 되었다. 그렇기에 나의 방식대로 기밀을 해제할 것이다."
msgstr ""

msgid "나는 징병대장으로서 이 섬에 왔다. 현대적인 행정체계의 일환으로서, 모든 개척자의 신원을 파악하고 그들을 적합한 부족의 호적에 올려둘 것이다. 그들은 더 이상 야생에 버려진 조난자가 아니게 될 것이다. 부족의 깃발이 그들을 따뜻하게 품어주리라."
msgstr ""

msgid "나는 차라리 이렇게 말하는 겁니다."
msgstr ""

msgid "나는 참 쫄보여."
msgstr ""

msgid "나는 체면을 생각하고 있어. 기준이 다른 거지. 남들은 참 쉽게 말하는군."
msgstr ""

msgid "나는 칸다 사와라트예요. 뭐 여러 루트로 내 얘기를 들으셨을 거예요."
msgstr ""

msgid "나는 턱막이다. 생소한 일이다. 몰이꾼은 짐승을 몰고 덫꾼이 덫을 놓아 짐승의 발을 붙잡고 칼잡이와 활잡이, 창잡이가 짐승의 숨통을 끊는다. 그 과정은 순탄치 않다. 강한 턱이 달린 짐승이 사람을 물면 큰일난다. 누군간 갑옷을 걸치고 다른 사람을 대신해 턱의 관심을 끌어야 한다. 턱막이의 일이다."
msgstr ""

msgid "나는 포럼을 위해 몇 년을 봉직했어. 포럼이 이만큼 큰 것도 내가 그만큼 돈 문제를 해결해줬기 때문에 가능했던 거라고, 어떻게 나한테,"
msgstr ""

msgid "나는 포럼의 사무국장을 만나본 적이 없지만요. 사무국장이 교통정리를 해주면 포럼에서 운영처가 더 무게 중심을 가져올 수 있을 거라고 봐요. 떽떽대는 활동처 얘기만 듣고 있는 것 같은데 운영처도 세게 굴어야 합니다."
msgstr ""

msgid "나는 폭력에 길들여졌다. 무언가가 일이 되면, 무언가에 더는 감정을 느끼기 어렵게 된다. 나는 운송로를 확보하고, 조난자를 찾아다녔다. 조난자에겐 징집의 의무를 설명했다. 모든 절차는 우리의 기준에서 합법적으로 이뤄졌다. 그러나 알았다. 이게 노예와 무엇이 다른가?"
msgstr ""

msgid "나는 해일과 폭풍이 내 고향을 쓸어 버렸던 순간을 늘 기억한다. 자연은 나에게 그렇게 계시했다. 이런 활동을 하는 누구든 그렇게 자연이 속삭인 순간이 있을 것이다. 흔들리지 말고 신념을 지키자."
msgstr ""

msgid "나는 회사의 F요. 호출부호는 중요하지 않소."
msgstr ""

msgid "나도 A가 남긴 메모를 봤어. A가 그리 된 것이 참 안타까워."
msgstr ""

msgid "나도 K님이나 찰리님처럼 되고 싶다. 하지만 부끄러움이 많아서 그 두 분한테 무전은 못 보내겠다. 그분들 무전을 듣고 있는 건 비밀이다. 이 메모를 그분들이 주워서 보게 된다면… 일단 팬이라고 알고 계세요. 정말 존경하고 사랑합니다. 멋지세요."
msgstr ""

msgid "나도 그 무전을 들었어요. 당신도 들었죠?"
msgstr ""

msgid "나도 그 싸움을 최대한 돕고 싶어. 나도 이 <em>듀랑고</em>를 꽤 좋아하니까 말이여."
msgstr ""

msgid "나도 그 인간적인 친분을 쌓으려고, 바스크어를 공부했지."
msgstr ""

msgid "나도 그랬어."
msgstr ""

msgid "나도 그렇게 생각했는데… 쌍둥이였지."
msgstr ""

msgid "나도 나무가 많은 동네에서 태어나 어릴 적부터 나무 다듬었으면 질려버렸을지도 모르지."
msgstr ""

msgid "나도 듀랑고에 산지 인자 시간이 좀 흘렀는데. 회사는 참 꾸준혀."
msgstr ""

msgid "나도 들은 걸 정리한 거긴 한데, 아무튼 그랬다고 합니다. 부족 경제 정책 연구하고 그런 곳이었죠."
msgstr ""

msgid "나도 살아야 하니까"
msgstr ""

msgid "나도 세상 문제를 그리 요약해서 볼 수 있으면 좋겄어. 근데 그렇지가 않잖여."
msgstr ""

msgid "나도 쉴 때면 옷감을 <em>{item_0}</em>해보곤 해요. 원래의 색깔을 다른 색깔로 바꿔간다는 게, 왠지 세상 모든 게 좋은 방향으로 갈 수 있을 것 같단 기분을 느끼게 해주거든요. 엄청 좋은 기분이죠. 그러니 <em>{item_1}</em>을 다른 개척자들도 써 볼 수 있게 해주자고요."
msgstr ""

msgid "나도 이제 도시인!"
msgstr ""

msgid "나도 점점 할머니처럼 되어 가나벼."
msgstr ""

msgid "나도 처음에 제안 받았을 땐 놀랐어. 조국의 이익을 위해 활동하는 줄 알았는데, 그런 차원이 아니었잖아. 하하."
msgstr ""

msgid "나도 추가합니다. 부족장이 자기 동생을 2인자로 앉힌 부족에서 일했는데, 뭐 그런 부족이 너무 많아서 거기 부족장이 이거 보고 열받아서 내가 누군지 찾아낼 수도 없겠죠. 암튼 그 동생 새X가 사냥 때마다 덫을 잘못 파놔서 많이들 죽었어요. 부족장 동생이 2인자인 부족은 가지 마세요."
msgstr ""

msgid "나도 프로 개척자"
msgstr ""

msgid "나도 한동안 잊고 지내려고 했어. 우리 모두한테 안 좋은 일이었잖니."
msgstr ""

msgid "나도 회사에 들어가고 싶었어. 당신네들은 구조 활동이 진짜 목표가 아니잖아. 그 사람들을 살려서 어딘가에 이용하려는 거지. 난 도덕심 같은 건 제로야. 뭐든 할 수 있어. 날 회사에 끼워줘."
msgstr ""

msgid "나도, 앙코라도, 괴로운 일이 많겠지만, 그래도 나아갈 수 있으면 좋겠어요. "
msgstr ""

msgid "나랑 거래하는 부족장들이 그러는데, 이번 이슈에서 우르줄라를 믿는대."
msgstr ""

msgid "나랑 먼저 얘기해야겠어. 당신. 도대체 <em>이 일</em>에 얼마나 책임이 있고, 어떻게 개입을,"
msgstr ""

msgid "나랑 일하는 친구들은 회사가 단순한 구조단체라고 안 봅니다. 나도 여러 부족에 돈 받아가면서 정보 물어다 주는 사람이다 보니 들은 게 많아요. 이름부터가 회사라니, 정보기관이 자기 비하하는 기분이군요."
msgstr ""

