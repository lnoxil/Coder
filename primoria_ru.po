msgstr ""

msgid "이 채널을 우르줄라가 들을 수도 있으니까, 우르줄라가 당신 별로 안 좋아하는 거 알죠?"
msgstr ""

msgid "이 친구 말로는 우리가 타고 온 건 3등급 워프고, 저건 2등급 워프라고 하는구먼."
msgstr ""

msgid "이 친구가 워프학 박사인데, 본인이 직접 학위를 수여했단 거 빼곤 괜찮은 친구여."
msgstr ""

msgid "이 친구들은 자네를 앙코라라고 부르는구먼. 자넨 참 성실혀."
