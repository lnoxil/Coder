msgid "애들레이드"
msgstr ""

msgid "애들은 왜 이리 안 자랄까? 인생 살면서 할 일 참 많은데, 여기에 자원이 쏠려버려. 일은 꾸준히 굴러가야 하는데 말이야. 당신아. <em>{item_0}</em> 구해다줘. 직접 만들었으면 꽤 솜씨가 붙었겠네. 실무자가 되건 관리자가 되건, 뭔가 하나 매달리는 건 좋은 일이야."
msgstr ""

msgid "애들을 사막에 데리고 갔던 생각이 나네. 지구엔 그런 섬보다 수백 배는 더 큰 사막이 있단 말을 애들이 안 믿었지. 사막에도 자원은 많으니, 건축 수요도 있어. <em>{item_0}</em>를 구해다줘 당신아."
msgstr ""

msgid "애들이 공룡 참 좋아하는데. 나는 공룡이 없으면 좋겟더라고."
msgstr ""

msgid "애들이 물어봐. 요새 토끼발은 어디 갔냐고."
msgstr ""

msgid "애들이 사무실에 있거든. 맡길 데가 있는 동네가 아니잖아."
msgstr ""

msgid "애들이 손재주는 좋아. 천막 짓고 이런 거는 나보다 더 후딱이여."
msgstr ""

msgid "애들이 지구 역사를 궁금해해서 이것저것 들려줬어."
