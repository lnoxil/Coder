msgstr ""

msgid "다른 옷 위에 입을 수 있는 교복 헤드셋. \"과거는 흘러가지만, 음악으로 돌아온다.\""
msgstr ""

msgid "다른 옷 위에 입을 수 있는 군복. \"압제자의 옷은 이제 해방자의 옷이 되었다.\""
msgstr ""

msgid "다른 옷 위에 입을 수 있는 금속처럼 반짝이는 타이츠. \"어딘가 침입하고 싶은 기분이 든다.\""
msgstr ""

msgid "다른 옷 위에 입을 수 있는 기름독 내복. \"잠은 살면서 가장 오래 즐길 수 있는 여행이다.\""
msgstr ""

msgid "다른 옷 위에 입을 수 있는 다시키 셔츠. \"먼 고향이라도, 만날 수 있다.\""
msgstr ""

msgid "다른 옷 위에 입을 수 있는 덩굴 작업모 외형장비. \"숨겨야 할 게 있으면 덩굴에 숨겨라.\""
msgstr ""

msgid "다른 옷 위에 입을 수 있는 덩굴 작업복 외형장비. \"해결책이 없을 땐 일단 숨는 것도 좋은 전략이다.\""
msgstr ""

msgid "다른 옷 위에 입을 수 있는 레인코트 \"장화는 덤이다.\""
msgstr ""

msgid "다른 옷 위에 입을 수 있는 로브 카디건. \"야생이지만 여긴 휴양지인것만 같다\""
msgstr ""

msgid "다른 옷 위에 입을 수 있는 롱 자켓. \"옷이지만 뭐든 담을 수도 있을 것만 같다.\""
msgstr ""

msgid "다른 옷 위에 입을 수 있는 마녀 모자. \"숟가락 대신 모자를 구부려봤다.\""
msgstr ""

msgid "다른 옷 위에 입을 수 있는 마녀 모자. 사용감이 있다. \"숟가락 대신 모자를 구부려봤다.\""
msgstr ""

msgid "다른 옷 위에 입을 수 있는 마녀 의상. \"사탕을 준다고 랩터가 봐주진 않을 것.\""
msgstr ""

msgid "다른 옷 위에 입을 수 있는 마녀 의상. 사용감이 있다. \"사탕을 준다고 랩터가 봐주진 않을 것.\""
msgstr ""

msgid "다른 옷 위에 입을 수 있는 무대 의상 헤드셋.  \"머리 크기의 차이가 세상의 전부는 아니다.\""
msgstr ""

msgid "다른 옷 위에 입을 수 있는 무대 의상. \"세상이 너의 무대고 대관료는 너의 부끄러움이다.\""
msgstr ""

msgid "다른 옷 위에 입을 수 있는 브라키오 의상. \"브라키오사우루스는 앞다리가 뒷다리보다 길다.\""
msgstr ""

msgid "다른 옷 위에 입을 수 있는 산타 모자. \"누구도 나의 선물에서 벗어날 수 없다.\""
msgstr ""

msgid "다른 옷 위에 입을 수 있는 산타 의상. \"누가 착한 아이인지는 내가 결정한다.\""
msgstr ""

msgid "다른 옷 위에 입을 수 있는 술 달린 파티복. \"이번 파티에는 주목을 받을 수 있을 것이다.\""
msgstr ""

msgid "다른 옷 위에 입을 수 있는 야생 달토끼머리 \"토끼 문명이 있다면 토끼 귀에 맞는 하이엔드 헤드폰도 있을 것이다.\""
msgstr ""

msgid "다른 옷 위에 입을 수 있는 야생 달토끼의상 \"달은 최초의 로르샤흐 테스트였다.\""
msgstr ""

msgid "다른 옷 위에 입을 수 있는 재활용 방독면 외형장비. \"필요는 형태를 정당화한다.\""
msgstr ""

msgid "다른 옷 위에 입을 수 있는 재활용 작업복 외형장비. \"환경 파괴를 집행 유예한다.\""
msgstr ""

msgid "다른 옷 위에 입을 수 있는 체육복. \"운동은 길고 지루한 삶에 약간은 위로가 된다.\""
msgstr ""

msgid "다른 옷 위에 입을 수 있는 축제 의상. \"어느 시대, 어느 기후에나 의전은 필요하다.\""
