msgid "이곳에서 태어난 아이가 묻는다."
"이곳에서 태어난 아이가 묻는다.\n"
"'호랑이가 뭐야?'\n"
"'스밀로돈이랑 비슷한데 송곳니가 짧고 몸이 황색에 검은 줄무늬가 있어.'"
msgstr ""

msgid "이곳에서 태어난 아이들의 키는 지구 출신보다 작았다."
"이곳에서 태어난 아이들의 키는 지구 출신보다 작았다.\n"
"지구에서 온 사람들은\n"
"고대의 거인으로 남게 될 것이다."
msgstr ""

msgid "이곳에선 다들 죽음을 아무렇지 않게 이야기한다."
"이곳에선 다들 죽음을 아무렇지 않게 이야기한다.\n"
"그렇다고 죽음이 관대한 건 아니다."
msgstr ""

msgid "이곳에선 항해할 수 있는 개인섬을 찾지 못했습니다."
msgstr ""

msgid "이곳엔 많은 <em>추억</em>이 있어요. 둘러볼 게 많이 있죠.[-]"
msgstr ""

msgid "이곳은 <em>불안정 지수</em>가 높은 만큼 험난한 곳이죠. 하지만 그런 이야기도 있잖아요. 심연 속으로 침몰해야 인생의 보물을 찾을 수 있다고요."
msgstr ""

msgid "이곳은 대기, 해수, 토질 구성비가 신생대 지구와 비슷하지만"
"이곳은 대기, 해수, 토질 구성비가 신생대 지구와 비슷하지만\n"
"여러 시대의 생물이 적응합니다.\n"
"우리가 알던 생물과 유사하지만 아예 다른 생물일 수도 있습니다.\n"
"– 비전문가"
msgstr ""

msgid "이곳은 샐러드 보울 같은 곳이란다. 다양한 인종과 문화가 한데 섞여서 서로 영향을 주고받지. 좋은 영향이든 나쁜 영향이든 간에 말야. <em>{item_0}</em>을 알고 있니? <em>{item_0}</em>이라는 낯선 음식이 근래 사람들 사이에서 크게 유행하고 있다는데, 실체를 확인해봐야겠구나."
msgstr ""

msgid "이곳은 축복의 땅입니다."
msgstr ""

msgid "이곳을 공룡 아포칼립스라 부르는 사람들도 있는데 사실과 다르다."
"이곳을 공룡 아포칼립스라 부르는 사람들도 있는데 사실과 다르다.\n"
"그저 사고로 모든 걸 잃고 거친 땅에 아무런 기반도 없이 처박혀\n"
"사망률이 높아졌을 뿐이다."
msgstr ""

msgid "이곳의 꽃들은 화학 성적이 나빴던 인간들에게 좋은 약재가 되고 있단다. 이런 걸 열쇠 자원이라고 하는데, 그 섬에선 <em>{item_0}</em>가 그렇겠구나. 자원의 가치는 자원의 위치에서 결정되는 게 아니라, 발견한 자들의 위치에서 결정된단다. 선점하자꾸나."
msgstr ""

