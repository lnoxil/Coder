msgid "무법섬과 이제 얼마 떨어지지 않은 곳에 계시지 않습니까?"
msgstr ""

msgid "무법섬까지 가서 다른 부족에 숨었더라고. 거기 부족장이랑 얘기 진행하느라 걸렸어."
msgstr ""

msgid "무법섬에 가서 싸워줘. 당신아."
msgstr ""

msgid "무법섬에 가서 전황을 파악하고 전쟁을 조정할 수 있는 역량을 갖추거라."
msgstr ""

msgid "무법섬에 다녀온 정보원의 보고 요약입니다. 무전으로 전해드립니까?"
msgstr ""

msgid "무법섬에 다녀올까 생각 중이여. 많은 생각이 들 것 같어."
msgstr ""

msgid "무법섬에 대응해야 한단다"
msgstr ""

msgid "무법섬에 비즈니스 기회가 많아. 부족들이 그동안 열심히 모아둔 자원을 거기다 쏟아붓고 있거든. 뭐 그 사람들이야 그리 써도, 그 돈이 우리에게 흘러오면 우리 같은 사람은 가치있게 쓸 줄 알잖아? <em>{item_0}</em>를 구해다줘. 부탁해."
msgstr ""

msgid "무법섬에 수요가 많아서 개척자들이 가도록 유도하고 있어. 가는 길에 이런 저런 요구사항이나 외주가 많아. <em>{item_0}</em> 떼다 줄 수 있지? 토끼발. 당신 장점이 급한 상황에서도 항상 최상의 퀄리티를 뽑는 거야."
msgstr ""

msgid "무법섬에 왔어. 무전이 안 돼. 부족들이 전쟁 중인데 큰 불이 났는데 끄질 않아. 자기 워프홀 있는 진영이 아니니 상관 없대. 기왕이면 적진을 태워버렸으면 좋겠다고 하더군. 불은 평등하게 다 태워버리는데 말이야."
msgstr ""

msgid "무법섬에 페나코두스자리 별 모양으로 깃발 쓰는 부족 알아요? 꽤 유명한 부족인데. 거기 부족장은 타르보사우루스한테 산 채로 내장을 뜯겨야해. 전쟁 중에 자기가 원하는 화단을 못 꾸몄다고 병사 셋을 교수형에 처했거든. 그거 보고 바로 도망쳐나왔어요."
msgstr ""

msgid "무법섬에는 아직 무지와 탐욕이 들끓습니다."
msgstr ""

msgid "무법섬에도 공룡이 살긴 사는구먼."
msgstr ""

msgid "무법섬에서 거점을 점령해 보세요!"
msgstr ""

msgid "무법섬에서 무기로 쓴다고, 근처의 불안정섬에서 무기로 쓸 만한 건 다 가져 간다는 흉흉한 얘기가 있더라고요. 뭐 그래서 <em>{item_0}</em>가 필요할 것 같아요. 만들어도 좋고, 구해다 줘도 좋아요."
msgstr ""

msgid "무법섬에서 벌어지는 일을 듣고 있니? 세상에서 늘 이기는 인간들은 비합리적인 인간이란다. 거기 일은 거기 일이니 133 너는 <em>{item_0}</em>를 찾고 그 <em>{item_1}</em>를 챙겨 오거라."
msgstr ""

msgid "무법섬에서 벌어지는 일이 무엇이건간에, 정보를 얻어둬야 할 것 같아서 활동가들을 그쪽으로 보내고 있습니다. 그래서 표본을 구하는 일이 병목이 됐습니다. 선생님이 해결해주시길 간절히 바랍니다. <em>{item_0}</em>의 <em>{item_1}</em>가 필요합니다. 선생님."
msgstr ""

msgid "무법섬에서 부상자들이 와요"
msgstr ""

msgid "무법섬에서 부족장을 만날 때 심기를 거스르지 않도록 한다. 최대한 예의있게 대한다. 무법섬에서 우리와 협조하는 부족들은 중무장했고 긴 전쟁을 치른 베테랑들이다. 비용 문제 등에서 갈등이 있을 경우엔 반드시 데스크로 보고하고 데스크의 지시에 따르도록 한다."
msgstr ""

msgid "무법섬에서 새로운 거점을 점령하세요."
msgstr ""

msgid "무법섬에서 수요가 있나봐"
msgstr ""

msgid "무법섬에서 식량을 엄청나게 소모해서, 근처의 불안정섬 자원까지 거기로 간다는 얘기가 있더라고요. 책에서 기회비용이란 거 배웠는데, 그걸 아는 사람들이 왜 전쟁을 하는 거죠? 캠프에 올 개척자들 위해서 <em>{item_0}</em>라도 있으면 좋겠어요."
msgstr ""

msgid "무법섬에서 온갖 생각이 충돌한단 얘기를 들었습니다. 어쨌건 인간이 여러 방식으로 스스로의 개체 수를 조절한다는 건 다행인 일입니다. 지구에선 저출산이 그 역할을 했지만, 여기선 전쟁이 그렇겠지요. 연구는 계속 되어야 합니다. <em>{item_0}</em> <em>{item_1}</em>이 필요합니다. 선생님."
msgstr ""

msgid "무법섬에서 인간의 숫자 조절이 이뤄지고 있는 순기능이 있긴 하지만, 환경이 파괴되는 역기능도 일어나고 있죠. 시류에 흔들리지 말고 활동과 연구는 병행되어야 합니다. <em>{item_0}</em>에 자라나는 <em>{item_1}</em> 자료를 구해다주십시오. 선생님."
msgstr ""

msgid "무법섬에서 일어나는 얘기들 들었어요? 다 믿진 못 하겠지만, 기껏 워프에서 살아남은 사람들이 그런 식으로 인생을 끝낸다는 건 씁쓸하네요. 캠프의 개척자들은 살아남고 번창하는 데 집중해줬으면 좋겠어요. <em>{item_0}</em>이 필요하니 구해다주세요."
msgstr ""

msgid "무법섬에서 일어나는 일들 말입니다. 개척 회의에서 나갈 방향이 어쩔지를, 노왁님께서 제시해야 하지 않을까요?"
msgstr ""

