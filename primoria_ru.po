msgid "무전기에서 멜로디를 들었다는 제보가 쏟아지고 있어요. 누군가 <em>라디오 방송국</em>이라도 개국한 걸까요? "
msgstr ""

msgid "무전기의 초록 불빛이 이렇게 반가울 때가 있었나 싶은디. 밀려있던 무전 연락 때문에 지금은 정신이 없네. 자네 다음에 또 이야기허자구."
msgstr ""

msgid "무전에서 징집 대상자를 비하하는 발언을 삼간다. 그런 얘기를 하고 싶다면 그냥 무전 밖에서 해라. 여기가 아무리 야생이라고 해도, 우리 절대 다수는 현대에서 넘어온 인물이며 현대적인 언어 감수성에 예민하다는 걸 명심한다. 합법적인 행동은 입 바른 말 위에서 더 빛을 발한다."
msgstr ""

msgid "무전으로 밖에 도움을 못 줘서 미안해. 앙코라, 이럴 때일수록 <em>미소의 힘</em>을 믿자?"
msgstr ""

msgid "무전으로 성명 낼 거야? 애도하거나 비난?"
msgstr ""

msgid "무전으로 자기 광고를 열심히 하는 기술자들이 있단다. 무슨 얘기인지 궁금해서 듣고 싶은데 오지를 않더구나. 데리러 갈 운전사들을 보냈는데, 운전사들이 배가 고프구나. <em>{item_0}</em>의 <em>{item_1}</em>가 먹고 싶다고 하니까 구해주거라."
msgstr ""

msgid "무전은 누구나 들을 수가 있지요. 선생님. 뭐 적절한 갈등은 포럼에 좋은 윤활유가 되겠지만요."
msgstr ""

msgid "무전을 길게 들어도 잘 기억하게 되더라고. 그래서 내가 이거에 가설을 세워봤지."
msgstr ""

msgid "무전을 도청하고 있으면, 세상엔 사람의 숫자만큼 다양한 멍청함이 있단 걸 느낀단다."
msgstr ""

msgid "무전을 많이 날려서 그런가 숲 쪽에 동창회라도 연 것 같았어요. 약탈자들은 단일한 그룹이 아니었어요. 화살이 날아오는 방향과 날아가는 방향이 매트릭스 조직만큼이나 복잡했거든요. 그들은 해진 옷을 기워 입었고 얼굴에 칠을 했어요. 군화를 신고 동물의 모피를 둘렀어요. DEVGRU에서 불명예 전역한 야만족들 같았죠."
msgstr ""

msgid "무전이 다시 왔어요. 구조대는 없을 거니까 살고 싶으면 맨 몸으로 나와서 물살을 헤엄치라고 하더군요. 저는 카메라를 점검했는데 저장장치가 꽉찼어요. 녹화한 화면을 보니 우주배경복사 같았어요. 6시간이 넘는 분량이었어요. 소름이 돋았죠. 사람들에게 비행기가 시공간 도약을 한 것 같다고 말했어요. 다들 제 말을 무시하고 친구도 안 듣더군요."
msgstr ""

